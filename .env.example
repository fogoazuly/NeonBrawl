# Copie para .env e preencha com os dados PUBLICOS do projeto Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Nunca coloque a chave secret/service_role nem o segredo OAuth do Google aqui.

# Somente no servidor Render (não em variáveis públicas do Pages):
# TURN_PROVIDER=metered
# METERED_DOMAIN=neonbrawl-fogoazuly.metered.live
# METERED_API_KEY=
# Alternativa Cloudflare (omita TURN_PROVIDER):
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# FRONTEND_ORIGIN=https://fogoazuly.github.io
# No Pages, após ativar e testar o serviço: PEER_SERVER_URL e TURN_ENABLED=1.
